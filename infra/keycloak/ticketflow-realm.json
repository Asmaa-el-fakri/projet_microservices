{
  "realm": "ticketflow",
  "displayName": "TicketFlow",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "roles": {
    "realm": [
      { "name": "CLIENT", "description": "Client authentifie : reserve, consulte ses billets" },
      { "name": "ORGANIZER", "description": "Organisateur : gere ses evenements" },
      { "name": "ADMIN", "description": "Administrateur de la plateforme" }
    ]
  },
  "clients": [
    {
      "clientId": "ticketflow-web",
      "name": "TicketFlow Web (Angular)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "rootUrl": "http://localhost:4200",
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      }
    }
  ],
  "users": [
    {
      "username": "client1",
      "email": "client1@ticketflow.test",
      "emailVerified": true,
      "firstName": "Client",
      "lastName": "Test",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "client123", "temporary": false }],
      "realmRoles": ["CLIENT"]
    },
    {
      "username": "organizer1",
      "email": "organizer1@ticketflow.test",
      "emailVerified": true,
      "firstName": "Organisateur",
      "lastName": "Test",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "organizer123", "temporary": false }],
      "realmRoles": ["ORGANIZER"]
    },
    {
      "username": "admin1",
      "email": "admin1@ticketflow.test",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Test",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "admin123", "temporary": false }],
      "realmRoles": ["ADMIN"]
    }
  ]
}